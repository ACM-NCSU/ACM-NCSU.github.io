---
// Self-hosted fonts (npm i @fontsource/instrument-serif @fontsource-variable/inter-tight @fontsource-variable/jetbrains-mono)
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/inter-tight';
import '@fontsource-variable/jetbrains-mono';

import BaseHead from '../components/BaseHead.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_TITLE, description = SITE_DESCRIPTION } = Astro.props;

const year = new Date().getFullYear();

// Normalise "/about/", "/about" and "/about.html" so the active link matches.
const currentPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/+$/, '') || '/';

const navLinks = [
  { href: '/about/', label: 'About' },
  { href: '/events/', label: 'Events' },
  { href: '/calendar/', label: 'Calendar' },
  { href: '/resources/', label: 'Resources' },
  { href: '/gallery/', label: 'Gallery' },
];

const isCurrent = (href: string) => currentPath === href.replace(/\/+$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <meta name="theme-color" content="#0f0e0d" />
    <!-- Lets CSS hide .reveal items only when JS is actually running. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="site">
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <nav class="nav wrap" aria-label="Main navigation">
        <a class="brand" href="/" aria-label="ACM at NC State home">
          <span class="brand-acm">ACM</span>
          <span class="brand-at">@</span>
          <span class="brand-nc">NC State</span>
        </a>

        <button
          class="menu-toggle"
          id="menuToggle"
          type="button"
          aria-expanded="false"
          aria-controls="navLinks"
          aria-label="Toggle navigation"
        >
          <span class="menu-bars" aria-hidden="true"></span>
        </button>

        <div class="nav-links" id="navLinks">
          {navLinks.map((link) => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
          ))}
          <a class="nav-cta" href="/involved/" aria-current={isCurrent('/involved/') ? 'page' : undefined}>
            Get involved <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </nav>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-top">
          <div class="reveal">
          <h2 class="footer-tagline">Build what's <span class="accent">next.</span></h2>
          <p class="intro">
            How do we help?
            Weekly Events, Tech talks, workshops,
            socials, networking, and professional development.
            Committees & Major ACM Events Opportunities to gain experience, 
            get involved, and build connections.
          </p>
        </div>

          <div class="footer-cols">
            <div>
              <h2 class="footer-head">Explore</h2>
              <a href="/about/">About</a>
              <a href="/events/">Events</a>
              <a href="/calendar/">Calendar</a>
              <a href="/gallery/">Gallery</a>
            </div>
            <div>
              <h2 class="footer-head">Connect</h2>
              <a href="/involved/">Join ACM</a>
              <a href="/resources/">Resources</a>
              <a href="https://github.com/ACM-NCSU/ACM-NCSU.github.io" target="_blank" rel="noopener noreferrer">GitHub</a>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <span class="brand-lockup"><span class="brand-acm">ACM</span> <span class="brand-at">@</span> <span class="brand-nc">NC State</span></span>
          <span class="copyright">© {year} ACM Student Chapter at NC State University.</span>
        </div>
      </div>
    </footer>

    <script>
      // Mobile menu
      const menuToggle = document.getElementById('menuToggle');
      const navLinks = document.getElementById('navLinks');

      if (menuToggle && navLinks) {
        const setMenu = (open: boolean) => {
          navLinks.classList.toggle('open', open);
          menuToggle.classList.toggle('open', open);
          menuToggle.setAttribute('aria-expanded', String(open));
        };

        menuToggle.addEventListener('click', () => {
          setMenu(!navLinks.classList.contains('open'));
        });

        navLinks.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setMenu(false));
        });

        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && navLinks.classList.contains('open')) {
            setMenu(false);
            menuToggle.focus();
          }
        });
      }

      // Reveal-on-scroll. Once an element has faded in we strip the helper classes so
      // they can't fight with the element's own hover transform/transition.
      const revealItems = document.querySelectorAll<HTMLElement>('.reveal');

      const show = (el: HTMLElement) => {
        el.classList.add('visible');
        const settle = (event: TransitionEvent) => {
          if (event.target !== el || event.propertyName !== 'opacity') return;
          el.removeEventListener('transitionend', settle);
          el.classList.remove('reveal', 'visible');
        };
        el.addEventListener('transitionend', settle);
      };

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              show(entry.target as HTMLElement);
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });

        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add('visible'));
      }
    </script>
  </body>
</html>

<!--
  Everything below is intentionally global and prefixed with `body.site`.
  global.css (imported by BaseHead) styles bare elements (main, h1, a, p, img, pre...).
  `body.site` out-ranks those rules without !important, while still losing to the
  single-class scoped rules inside each page, which is what we want.
-->
<style is:global>
  :root {
    --bg: #0f0e0d;
    --bg-2: #151311;
    --panel: #1a1816;
    --paper: #f3eee6;
    --text: #f3eee6;
    --muted: #a8a199;
    --faint: #77716a;
    --line: rgba(243,238,230,.14);
    --line-strong: rgba(243,238,230,.3);
    --red: #cc0000;
    --red-bright: #ff5b50;
    --max: 1200px;
    --radius: 14px;
    --serif: "Instrument Serif", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    --sans: "Inter Tight Variable", "Inter Tight", Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
    --mono: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html {
    color-scheme: dark;
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
    background: var(--bg);
  }

  body.site {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 17px; /* global.css sets 20px (18px under 720px) */
    line-height: 1.6;
    text-align: left;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  /* global.css constrains <main> to 850px and pads it. Pages manage their own width. */
  body.site main { width: auto; max-width: none; margin: 0; padding: 0; }

  body.site :is(h1, h2, h3, h4, h5, h6) { color: var(--text); }
  /* Display headings are serif; smaller headings stay sans. */
  body.site :is(h1, h2) { font-family: var(--serif); font-weight: 400; letter-spacing: -.02em; }
  body.site :is(h3, h4, h5, h6) { font-family: var(--sans); font-weight: 600; }

  /* global.css colours links red and underlines them on hover. */
  body.site a { color: inherit; text-decoration: none; }
  body.site a:hover { text-decoration: none; }
  body.site button { font: inherit; }

  body.site ::selection { background: var(--red); color: #fff; }

  body.site .wrap { width: min(var(--max), calc(100% - 56px)); margin-inline: auto; }

  body.site .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  body.site .skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: 100;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--paper);
    color: var(--bg);
    font-weight: 600;
  }
  body.site .skip-link:focus { left: 12px; }

  /* ---------- Header ---------- */
  body.site .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(15,14,13,.88);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  body.site .nav {
    min-height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 28px;
  }

  /* Wordmark only: no logo tile, no tagline. */
  body.site .brand { display: inline-flex; align-items: baseline; gap: .32em; line-height: 1; }
  body.site .brand-acm { font-family: var(--sans); font-weight: 800; letter-spacing: -.03em; font-size: 1.25rem; }
  body.site .brand-at { color: var(--red-bright); font-family: var(--mono); font-size: .95rem; }
  body.site .brand-nc { font-family: var(--serif); font-style: italic; font-size: 1.45rem; letter-spacing: -.01em; }

  body.site .nav-links { display: flex; align-items: center; gap: 30px; font-size: .95rem; color: var(--muted); }
  body.site .nav-links a { position: relative; transition: color .2s ease; }
  body.site .nav-links a:hover { color: var(--paper); }

  body.site .nav-links a[aria-current="page"]:not(.nav-cta) { color: var(--paper); }
  body.site .nav-links a[aria-current="page"]:not(.nav-cta)::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -7px;
    height: 1px;
    background: var(--red-bright);
  }

  body.site .menu-toggle {
    display: none;
    width: 42px;
    height: 42px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--paper);
    cursor: pointer;
  }
  body.site .menu-bars,
  body.site .menu-bars::before,
  body.site .menu-bars::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform .2s ease, background-color .2s ease;
  }
  body.site .menu-bars { position: relative; }
  body.site .menu-bars::before,
  body.site .menu-bars::after { content: ""; position: absolute; left: 0; }
  body.site .menu-bars::before { top: -6px; }
  body.site .menu-bars::after { top: 6px; }
  body.site .menu-toggle.open .menu-bars { background: transparent; }
  body.site .menu-toggle.open .menu-bars::before { transform: translateY(6px) rotate(45deg); }
  body.site .menu-toggle.open .menu-bars::after { transform: translateY(-6px) rotate(-45deg); }

  /* ---------- Buttons ---------- */
  body.site .btn,
  body.site .nav-cta {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    padding: 13px 22px;
    border: 1px solid transparent;
    border-radius: 10px;
    font-weight: 600;
    font-size: .95rem;
    line-height: 1.2;
    transition: background-color .2s ease, border-color .2s ease, color .2s ease;
  }

  body.site .nav-cta { padding: 9px 16px; font-size: .9rem; }

  body.site .btn .arrow,
  body.site .nav-cta .arrow { transition: transform .2s ease; }
  body.site .btn:hover .arrow,
  body.site .nav-cta:hover .arrow { transform: translateX(3px); }

  body.site .nav-cta,
  body.site .btn-primary { background: var(--red); border-color: var(--red); color: #fff; }
  body.site .nav-cta:hover,
  body.site .btn-primary:hover { background: #e31b1b; border-color: #e31b1b; }

  /* Secondary actions are quiet: an underlined text link, not a second button. */
  body.site .btn-secondary {
    padding-inline: 4px;
    border-radius: 0;
    border-bottom: 1px solid var(--line-strong);
    color: var(--paper);
  }
  body.site .btn-secondary:hover { border-bottom-color: var(--paper); }

  /* ---------- Shared type ---------- */
  body.site .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: .74rem;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  body.site .eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    background: var(--red-bright);
  }

  /* Numbered variant: "01  About" */
  body.site .eyebrow.numbered::before { display: none; }
  body.site .eyebrow b { color: var(--red-bright); font-weight: 500; }

  body.site .accent { color: var(--red-bright); font-style: italic; }

  body.site .text-link {
    color: var(--paper);
    text-decoration: underline;
    text-decoration-color: var(--red-bright);
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  body.site .text-link:hover { text-decoration: underline; text-decoration-color: var(--paper); }

  /* ---------- Inner page hero ---------- */
  body.site .page-hero {
    padding: clamp(72px, 10vw, 128px) 0 clamp(44px, 6vw, 72px);
    border-bottom: 1px solid var(--line);
  }

  body.site .page-hero h1 {
    margin: 22px 0 0;
    max-width: 14ch;
    font-size: clamp(3.4rem, 8.4vw, 7rem);
    line-height: .94;
  }

  body.site .page-hero .lede {
    max-width: 600px;
    margin: 28px 0 0;
    color: var(--muted);
    font-size: clamp(1.05rem, 1.7vw, 1.2rem);
  }

  body.site .page-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 32px; }

  /* ---------- Inner page sections ---------- */
  body.site .page-section { padding: clamp(56px, 8vw, 104px) 0; }
  body.site .page-section + .page-section { padding-top: 0; }

  body.site .page-section-head { margin-bottom: 36px; }

  body.site .section-title {
    margin: 14px 0 0;
    font-size: clamp(2.2rem, 4.6vw, 3.6rem);
    line-height: 1;
  }

  body.site .section-lede { margin: 14px 0 0; max-width: 560px; color: var(--muted); }

  body.site .empty-state {
    margin: 0;
    padding: 40px 24px;
    text-align: center;
    color: var(--muted);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
  }

  /* ---------- Rich text (markdown content in modals) ---------- */
  body.site .prose { color: #d8d2c9; line-height: 1.8; }
  body.site .prose > :first-child { margin-top: 0; }
  body.site .prose h1,
  body.site .prose h2,
  body.site .prose h3,
  body.site .prose h4 { margin: 1.6em 0 .5em; line-height: 1.2; }
  body.site .prose h1 { font-size: 2rem; }
  body.site .prose h2 { font-size: 1.7rem; }
  body.site .prose h3 { font-size: 1.2rem; }
  body.site .prose h4 { font-size: 1.05rem; }
  body.site .prose p { margin: 0 0 1.1em; }
  body.site .prose a { color: var(--paper); text-decoration: underline; text-decoration-color: var(--red-bright); text-underline-offset: 4px; }
  body.site .prose a:hover { color: var(--paper); text-decoration: underline; text-decoration-color: var(--paper); }
  body.site .prose ul,
  body.site .prose ol { margin: 0 0 1.1em; padding-left: 1.3em; }
  body.site .prose li { margin: .3em 0; }
  body.site .prose blockquote {
    margin: 1.2em 0;
    padding: 0 0 0 1rem;
    border-left: 2px solid var(--red-bright);
    color: var(--muted);
    font-family: var(--serif);
    font-size: 1.3em;
    line-height: 1.4;
  }
  body.site .prose img { margin: 1em 0; border-radius: 10px; }
  body.site .prose hr { border: 0; border-top: 1px solid var(--line); margin: 2em 0; }
  body.site .prose code {
    padding: 2px 6px;
    border-radius: 6px;
    background: rgba(243,238,230,.08);
    color: #ffd2cc;
    font-family: var(--mono);
    font-size: .88em;
  }
  body.site .prose pre {
    padding: 1rem;
    overflow: auto;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #0b0a09;
  }
  body.site .prose pre code { padding: 0; background: none; color: inherit; }

  /* ---------- Footer ---------- */
  body.site .site-footer { margin-top: 0; padding: clamp(56px, 8vw, 96px) 0 28px; border-top: 1px solid var(--line); }

  body.site .footer-top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 40px;
  }

  body.site .footer-tagline {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(3rem, 8vw, 6.4rem);
    line-height: .95;
    letter-spacing: -.02em;
  }

  body.site .footer-cols { display: flex; gap: clamp(36px, 6vw, 88px); }
  body.site .footer-cols a { display: block; padding: 4px 0; color: var(--muted); font-size: .95rem; transition: color .2s ease; }
  body.site .footer-cols a:hover { color: var(--paper); }
  body.site .footer-head {
    margin: 0 0 10px;
    color: var(--faint);
    font-family: var(--mono);
    font-size: .72rem;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
  }

  body.site .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  body.site .brand-lockup { display: inline-flex; align-items: baseline; gap: .3em; font-size: .9rem; }
  body.site .brand-lockup .brand-acm { font-size: 1rem; }
  body.site .brand-lockup .brand-nc { font-size: 1.15rem; }
  body.site .copyright { color: var(--faint); font-size: .82rem; }

  /* ---------- Reveal on scroll ---------- */
  html.js body.site .reveal {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity .7s ease, transform .7s ease;
  }
  html.js body.site .reveal.visible { opacity: 1; transform: translateY(0); }

  body.site a:focus-visible,
  body.site button:focus-visible,
  body.site [role="button"]:focus-visible { outline: 2px solid var(--paper); outline-offset: 4px; border-radius: 4px; }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    body.site .menu-toggle { display: inline-flex; }
    body.site .nav { min-height: 62px; }
    body.site .nav-links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 10px 28px 26px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      font-size: 1.1rem;
    }
    body.site .nav-links.open { display: flex; }
    body.site .nav-links a { padding: 14px 0; border-bottom: 1px solid var(--line); }
    body.site .nav-links a[aria-current="page"]:not(.nav-cta)::after { display: none; }
    body.site .nav-links a[aria-current="page"]:not(.nav-cta) { color: var(--red-bright); }
    body.site .nav-links .nav-cta { margin-top: 18px; padding: 14px 16px; border-bottom: 0; text-align: center; }
  }

  @media (max-width: 680px) {
    body.site { font-size: 16px; }
    body.site .wrap { width: min(100% - 36px, var(--max)); }
    body.site .footer-top { align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    body.site *, body.site *::before, body.site *::after {
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
    }
    html.js body.site .reveal { opacity: 1; transform: none; }
  }
</style>
