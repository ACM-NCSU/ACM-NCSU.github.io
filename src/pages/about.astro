];
---

<SiteLayout
  title={`About | ${SITE_TITLE}`}
  description="ACM at NC State is the student chapter of the Association for Computing Machinery. Meet our leadership, committees, and faculty advisors."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">About us</span>
      <h1>Who we <span class="accent">are.</span></h1>
      <p class="lede">
        ACM at NCSU is the student chapter of the Association for Computing Machinery at North Carolina State University.
        ACM is the world's largest educational and scientific computing organization.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="wrap">
      <div class="mission-grid">
        {mission.map((item) => (
          <article class="mission-card reveal">
            <span class="eyebrow">{item.label}</span>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="page-section" id="leadership">
    <div class="wrap">
      <div class="page-section-head reveal">
        <span class="eyebrow">The people behind ACM</span>
        <h2 class="section-title">Leadership</h2>
      </div>

      {sections.map((section) => (
        <div class="member-group" id={section.id}>
          <h3 class="group-title">{section.title}</h3>
          <div class="board-grid">
            {section.members.map((member, index) => (
              <button type="button" class="member-card" data-modal-open={modalKey(section.id, index)}>
                <div class:list={['member-photo', { 'is-logo': member.image === defaultImg }]}>
                  <Image
                    src={member.image}
                    alt=""
                    width={480}
                    style={member.imageStyle || undefined}
                  />
                </div>
                <div class="member-info">
                  <h4 class="member-name">{member.name}</h4>
                  <div class="member-title">{member.title}</div>
                </div>
              </button>
            ))}
          </div>
        </div>
      ))}

      {/* Add Sponsor Section here */}
    </div>
  </section>

  <Modal label="Member details" maxWidth="900px" />

  <!-- Hidden member data; copied into the dialog when a card is clicked -->
  <div id="modal-data" hidden>
    {sections.map((section) =>
      section.members.map((member, index) => (
        <div data-modal-id={modalKey(section.id, index)}>
          <div class="modal-member-layout">
            <div class="modal-member-image-container">
              <div class:list={['modal-photo', { 'is-logo': member.image === defaultImg }]}>
                <Image
                  src={member.image}
                  alt={`Photo of ${member.name}`}
                  width={640}
                  style={member.imageStyle || undefined}
                />
              </div>
              <div class="member-social-links">
                {socialLinks(member).map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    <span class="sr-only">Visit {member.name}'s {link.label}</span>
                    <Icon name={link.icon} width="28" height="28" />
                  </a>
                ))}
              </div>
            </div>

            <div class="modal-member-info">
              <h2>{member.name}</h2>
              {member.pronouns && <p class="member-pronouns">{member.pronouns}</p>}
              <p class="member-role">{member.title}</p>

              <dl class="member-details-list">
                {member.department ? (
                  <div><dt>Department</dt><dd>{member.department}</dd></div>
                ) : (
                  <>
                    {member.major && <div><dt>Major</dt><dd>{member.major}</dd></div>}
                    {member.minor && <div><dt>Minor</dt><dd>{member.minor}</dd></div>}
                    {member.gradYear && <div><dt>Graduation</dt><dd>{member.gradYear}</dd></div>}
                  </>
                )}
              </dl>

              {member.bio && <p class="member-bio">{member.bio}</p>}
            </div>
          </div>
        </div>
      ))
    )}
  </div>
</SiteLayout>

<style>
  .mission-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 44px;
  }

  .mission-card { padding-top: 22px; border-top: 1px solid var(--line-strong); }
  .mission-card p { margin: 22px 0 0; color: var(--muted); }

  .member-group { margin-top: 72px; }

  .group-title {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 28px;
    color: var(--muted);
    font-family: var(--mono);
    font-size: .76rem;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .group-title::before { content: ""; width: 7px; height: 7px; background: var(--red-bright); }
  .group-title::after { content: ""; flex: 1; height: 1px; background: var(--line); }

  .board-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 36px 22px;
  }

  .member-card {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .member-photo,
  .modal-photo {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: #211e1b;
  }

  /* Photos fill the frame unless a member sets their own object-fit/position inline. */
  .member-photo :global(img),
  .modal-photo :global(img) {
    width: 100%;
    height: 100%;
    display: block;
    border-radius: 0;
    object-fit: cover;
    object-position: center 20%;
    transition: transform .5s ease;
  }
  .member-card:hover .member-photo :global(img) { transform: scale(1.04); }

  /* The chapter logo stands in for members without a photo; keep it whole on a light tile. */
  .member-photo.is-logo,
  .modal-photo.is-logo { background: #ecebea; }
  .member-photo.is-logo :global(img),
  .modal-photo.is-logo :global(img) { object-fit: contain; object-position: center; padding: 16%; }

  .member-info { padding: 14px 0 0; }

  .member-name {
    margin: 0 0 4px;
    font-size: 1.08rem;
    font-weight: 600;
    letter-spacing: -.01em;
    transition: color .2s ease;
  }
  .member-card:hover .member-name { color: var(--red-bright); }

  .member-title {
    color: var(--muted);
    font-family: var(--mono);
    font-size: .7rem;
    letter-spacing: .06em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  /* ---------- Modal content (copied in from #modal-data) ---------- */
  .modal-member-layout { display: flex; gap: 36px; padding: 36px; }
  .modal-member-image-container { flex-shrink: 0; width: 280px; }

  .member-social-links { display: flex; gap: 6px; margin-top: 14px; }

  .member-social-links a {
    display: inline-flex;
    padding: 8px;
    border-radius: 10px;
    color: var(--muted);
    transition: color .2s ease, background-color .2s ease;
  }
  .member-social-links a:hover { color: var(--paper); background: rgba(243,238,230,.08); }

  .modal-member-info { flex: 1; min-width: 0; padding-right: 28px; }

  .modal-member-info h2 {
    margin: 0 0 6px;
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    line-height: 1;
  }

  .member-pronouns { margin: 0 0 12px; color: var(--muted); font-style: italic; }
  .member-role {
    margin: 0 0 24px;
    color: var(--red-bright);
    font-family: var(--mono);
    font-size: .8rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .member-details-list { margin: 0 0 24px; border-top: 1px solid var(--line); }
  .member-details-list div { display: flex; gap: 12px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .member-details-list dt { flex: 0 0 120px; color: var(--faint); font-family: var(--mono); font-size: .72rem; letter-spacing: .08em; text-transform: uppercase; padding-top: 3px; }
  .member-details-list dd { margin: 0; color: var(--paper); }

  .member-bio { margin: 0; color: #d8d2c9; line-height: 1.8; }

  @media (max-width: 900px) {
    .mission-grid { grid-template-columns: 1fr; gap: 36px; }
  }

  @media (max-width: 768px) {
    .board-grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 28px 14px; }

    .modal-member-layout { flex-direction: column; align-items: center; gap: 22px; padding: 24px; }
    .modal-member-image-container { width: 100%; max-width: 280px; }
    .modal-member-info { width: 100%; padding-right: 0; }
    .member-details-list div { flex-direction: column; gap: 2px; }
