// Every group gets its own id, which becomes part of each card's modal key
// (e.g. "managers-0" vs "project-0"), so two groups can never open each other's dialog.
const sections = [
    { id: 'executive', title: 'Executive Board', members: executiveBoard },
    { id: 'faculty', title: 'Faculty Advisors', members: facultyAdvisors },
    { id: 'tech', title: 'Tech Committee Members', members: techCommittee },
    { id: 'managers', title: 'Project Managers', members: projectManagers },
    { id: 'project', title: 'Project Committee Members', members: projectCommittee },
];

const socialLinks = (member: Member) =>
    [
        { label: 'website', icon: 'mdi:web', href: member.links?.website },
        { label: 'LinkedIn', icon: 'mdi:linkedin', href: member.links?.linkedin },
        { label: 'GitHub', icon: 'mdi:github', href: member.links?.github },
    ].filter((link) => link.href);

const modalKey = (sectionId: string, index: number) => `${sectionId}-${index}`;

const mission = [
    {
        label: 'Inclusive by design',
        text: "We're dedicated to building an inclusive community of computing students, academics, and professionals at NC State. Students and faculty from any discipline with an interest in computing are welcome to attend ACM at NCSU events and join us in fostering curiosity in the computational sciences.",
    },
    {
        label: 'Growth at every stage',
        text: 'We focus on introducing new students to the breadth of computer science while helping upperclassmen advance their careers through networking events, skill-building workshops, and internship connections.',
