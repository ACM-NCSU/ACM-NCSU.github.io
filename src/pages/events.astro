---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import SiteLayout from '../pages/SiteLayout.astro';
import Modal from '../pages/Modal.astro';
import { SITE_TITLE } from '../consts';

// Get all events and sort by date
const allEvents = await getCollection('events');
const now = new Date();

// An event stays "upcoming" until it has finished (end time if there is one, otherwise its start).
const endsAt = (event: (typeof allEvents)[number]) =>
  new Date(event.data.endDate ?? event.data.date);

// Separate upcoming and past events
const upcomingEvents = allEvents
  .filter((event) => endsAt(event) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const pastEvents = allEvents
  .filter((event) => endsAt(event) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// Format date helper
function formatDate(date: Date, endDate?: Date) {
  const formatter = new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });

  const timeFormatter = new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });

  if (endDate) {
    return formatter.format(date) + ' - ' + timeFormatter.format(endDate);
  }
  return formatter.format(date);
}

function formatLongDate(date: Date, endDate?: Date) {
  const formatter = new Intl.DateTimeFormat('en-US', {
    weekday: 'long',
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });

  const timeFormatter = new Intl.DateTimeFormat('en-US', {
    hour: 'numeric',
    minute: '2-digit',
    timeZone: 'America/New_York',
  });

  if (endDate) {
    return formatter.format(date) + ' - ' + timeFormatter.format(endDate);
  }
  return formatter.format(date);
}

// Render event content to HTML
const eventContents = new Map(
  await Promise.all(
    allEvents.map(async (event) => {
      const { Content } = await event.render();
      return [event.slug, Content] as const;
    })
  )
);
---

<SiteLayout
  title={`Events | ${SITE_TITLE}`}
  description="Workshops, tech talks, and socials hosted by ACM at NC State."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Make something happen</span>
      <h1>What's <span class="accent">happening.</span></h1>
      <p class="lede">
        Workshops, tech talks, and socials. Find what's coming up and revisit what you missed.
      </p>
      <div class="page-actions">
        <a class="btn btn-primary" href="/calendar/">View the calendar →</a>
        <a class="btn btn-secondary" href="/involved/">Get involved ↗</a>
      </div>
    </div>
  </section>

  <section class="page-section" id="upcoming">
    <div class="wrap">
      <div class="page-section-head reveal">
        <span class="eyebrow">Coming up</span>
        <h2 class="section-title">Upcoming Events</h2>
      </div>

      {upcomingEvents.length > 0 ? (
        <div class="events-grid">
          {upcomingEvents.map((event) => (
            <button type="button" class="event-card" data-modal-open={event.slug}>
              <div class="event-image">
                <Image src={event.data.image} alt="" width={400} height={300} quality={90} />
              </div>
              <div class="event-content">
                <h3>{event.data.title}</h3>
                <p class="event-date">
                  {formatDate(new Date(event.data.date), event.data.endDate ? new Date(event.data.endDate) : undefined)}
                </p>
                {event.data.location && <p class="event-location">{event.data.location}</p>}
              </div>
            </button>
          ))}
        </div>
      ) : (
        <p class="empty-state">No upcoming events at this time. Check back soon!</p>
      )}
    </div>
  </section>

  <section class="page-section" id="past">
    <div class="wrap">
      <div class="page-section-head reveal">
        <span class="eyebrow">Look back</span>
        <h2 class="section-title">Past Events</h2>
      </div>

      {pastEvents.length > 0 ? (
        <div class="events-grid is-past">
          {pastEvents.map((event) => (
            <button type="button" class="event-card" data-modal-open={event.slug}>
              <div class="event-image">
                <Image src={event.data.image} alt="" width={400} height={300} quality={90} />
              </div>
              <div class="event-content">
                <h3>{event.data.title}</h3>
                <p class="event-date">{formatDate(new Date(event.data.date))}</p>
                {event.data.location && <p class="event-location">{event.data.location}</p>}
              </div>
            </button>
          ))}
        </div>
      ) : (
        <p class="empty-state">No past events yet.</p>
      )}
    </div>
  </section>

  <Modal label="Event details" maxWidth="800px" />

  <!-- Hidden event data; copied into the dialog when a card is clicked -->
  <div id="modal-data" hidden>
    {allEvents.map((event) => {
      const Content = eventContents.get(event.slug);
      return (
        <div data-modal-id={event.slug}>
          <div class="modal-hero">
            <Image src={event.data.image} alt={event.data.title} width={1600} height={600} quality={90} />
          </div>
          <div class="modal-text">
            <h2>{event.data.title}</h2>
            <div class="event-meta">
              <p class="event-date">
                {formatLongDate(new Date(event.data.date), event.data.endDate ? new Date(event.data.endDate) : undefined)}
              </p>
              {event.data.location && <p class="event-location">📍 {event.data.location}</p>}
            </div>
            <div class="prose">{Content && <Content />}</div>
          </div>
        </div>
      );
    })}
  </div>
</SiteLayout>

<style>
  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 48px 26px;
  }

  .event-card {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .event-image { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 6px; background: #211e1b; }

  /* <Image /> lives in a child component, so reach its <img> with :global. */
  .event-image :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
    transition: transform .5s ease, filter .3s ease;
  }
  .event-card:hover .event-image :global(img) { transform: scale(1.04); }
  .is-past .event-image :global(img) { filter: saturate(.55); }
  .is-past .event-card:hover .event-image :global(img) { filter: none; }

  .event-content { padding: 18px 0 0; }

  .event-content h3 {
    margin: 0 0 10px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.85rem;
    line-height: 1.08;
    letter-spacing: -.01em;
    transition: color .2s ease;
  }
  .event-card:hover .event-content h3 { color: var(--red-bright); }

  .event-date {
    margin: 0;
    color: var(--red-bright);
    font-family: var(--mono);
    font-size: .74rem;
    letter-spacing: .06em;
    text-transform: uppercase;
  }
  .event-location { margin: 6px 0 0; color: var(--muted); font-size: .92rem; }

  /* ---------- Modal content (copied in from #modal-data) ---------- */
  .modal-hero { aspect-ratio: 8 / 3; overflow: hidden; background: #211e1b; }
  .modal-hero :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }

  .modal-text { padding: 34px; }
  .modal-text h2 {
    margin: 0;
    padding-right: 36px;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
  }

  .event-meta {
    margin: 22px 0 28px;
    padding: 16px 0;
    border-block: 1px solid var(--line);
  }
  .event-meta .event-date { font-size: .8rem; }
  .event-meta .event-location { margin-top: 8px; color: var(--paper); font-size: .98rem; }

  @media (max-width: 768px) {
    .events-grid { grid-template-columns: 1fr; }
    .modal-hero { aspect-ratio: 16 / 9; }
    .modal-text { padding: 24px; }
  }
</style>
