---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import SiteLayout from '../pages/SiteLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import slide1 from '../assets/slideshow/IMG_3554.JPG';
import slide2 from '../assets/slideshow/IMG_5606.png';
import slide3 from '../assets/slideshow/IMG_3548.JPG';
import slide4 from '../assets/slideshow/IMG_5604.png';
import slide5 from '../assets/slideshow/IMG_3562.JPG';
import slide6 from '../assets/slideshow/IMG_6118.png';
import slide7 from '../assets/slideshow/IMG_3552.JPG';

import logoImage from '../assets/logos/Logo.png';

// Pass the imported image objects directly so astro:assets can resize/convert them.
const slideshowImages = [slide1, slide2, slide3, slide4, slide5, slide6, slide7];

const heroImage = logoImage;

const heroAlt = 'ACM at NC State members together at an event'; // describe your photo here
const heroCaption = 'The Wolfpack builds here';

const marqueeItems = ['Technical workshops', 'Industry connections', 'Community events', 'Room to grow'];

const principles = [
  {
    title: 'Learn by doing',
    text: 'Explore new tools, sharpen your skills, and get hands-on experience through workshops, technical talks, and collaborative learning.',
  },
  {
    title: 'Grow your network',
    text: 'Meet fellow students, connect with faculty, and hear from people working across the technology industry.',
  },
  {
    title: "Your background isn't a barrier. It's a perspective.",
    text: "Whether you're writing your first program or diving deep into systems, AI, and research, there's room to contribute and learn here.",
    tags: [],
  },
];

const eventTypes = [
  { type: 'Get hands-on', title: 'Technical workshops', text: 'Try new technologies, build practical skills, and learn alongside other students.', cta: 'Explore events' },
  { type: 'Meet the industry', title: 'Tech talks & networking', text: 'Hear real-world perspectives, ask questions, and discover different paths into tech.', cta: "See what's happening" },
  { type: 'Find your community', title: 'Socials & meetups', text: 'Take a break, meet new friends, and connect with people who share your curiosity.', cta: 'Join the next one' },
];

const resourceLinks = [
  { href: '/resources/', title: 'CS resources', text: 'Courses, communities, and support' },
  { href: '/about/', title: 'Meet ACM', text: 'Our mission and leadership' },
  { href: '/gallery/', title: 'Photo gallery', text: 'See the community in action' },
  { href: '/events/', title: 'Event archive', text: 'Explore talks and workshops' },
];

const pad = (n: number) => String(n).padStart(2, '0');
---

<SiteLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero" id="home">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <span class="eyebrow">ACM @ NC State · Computing community</span>
        <h1>
          Curious minds.<br />
          Bold ideas.<br />
          <span class="accent">Real impact.</span>
        </h1>

        <p class="hero-copy">
          We're ACM at NC State — a student organization 
          helping students in tech & software thrive 
          academically, professionally, and socially.
          By a student. For a student.
        </p>

        <div class="hero-actions">
          <a class="btn btn-primary" href="/involved/">Find your place <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href="/events/">Explore events</a>
        </div>

        <p class="hero-note"><span class="status-dot"></span>Open to curious minds across NC State</p>
      </div>

      <figure class="hero-media">
        {heroImage ? (
          <Image
            src={heroImage}
            alt={heroAlt}
            widths={[480, 720, 960]}
            sizes="(max-width: 900px) 100vw, 460px"
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <div class="hero-placeholder">
            <span>Add your image at<br /><code>src/assets/hero.jpg</code></span>
          </div>
        )}
      </figure>
    </div>
  </section>

  <div class="marquee" aria-label="What we do">
    <div class="marquee-track">
      <ul class="marquee-group">
        {[...marqueeItems, ...marqueeItems].map((item) => <li>{item}</li>)}
      </ul>
      <ul class="marquee-group" aria-hidden="true">
        {[...marqueeItems, ...marqueeItems].map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>

  <section class="sec" id="about">
    <div class="wrap split">
      <div class="split-label"><span class="eyebrow numbered"><b>01</b>&nbsp; More than a club</span></div>

      <div class="split-body">
        <div class="reveal">
          <h2 class="display">Find your people.<br />Find your <span class="accent">potential.</span></h2>
          <p class="intro">
            ACM at NC State. A student organization helping students in 
            tech & software thrive academically, professionally, and socially.
            We are here to help students grow their skills and create connections 
            that last beyond graduation.
          </p>
        </div>

        <ol class="rows">
          {principles.map((item, index) => (
            <li class="row reveal">
              <span class="row-n">{pad(index + 1)}</span>
              <h3>{item.title}</h3>
              <div class="row-text">
                <p>{item.text}</p>
                {item.tags && (
                  <ul class="tags">
                    {item.tags.map((tag) => <li>{tag}</li>)}
                  </ul>
                )}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="sec sec-alt" id="events">
    <div class="wrap split">
      <div class="split-label"><span class="eyebrow numbered"><b>02</b>&nbsp; Make something happen</span></div>

      <div class="split-body">
        <div class="reveal">
          <h2 class="display">Come for the tech.<br />Stay for the <span class="accent">people.</span></h2>
          <p class="intro">
            From hands-on projects to industry conversations and socials,
            there's more than one way to be part of the community.
          </p>
        </div>

        <div class="event-list">
          {eventTypes.map((item) => (
            <a class="event-row reveal" href="/events/">
              <span class="event-type">{item.type}</span>
              <span class="event-main">
                <span class="event-title">{item.title}</span>
                <span class="event-text">{item.text}</span>
              </span>
              <span class="event-cta">{item.cta} <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>

        <p class="after-list"><a class="btn btn-secondary" href="/calendar/">View the calendar →</a></p>
      </div>
    </div>
  </section>

  <section class="join" id="join">
    <div class="wrap join-grid">
      <div class="reveal">
        <span class="eyebrow light">Your next step</span>
        <h2>There's a place for you in this <span class="join-accent">community.</span></h2>
        <p>
          Show up curious. Leave with new skills, new connections,
          and a better idea of what you can do.
        </p>
        <a class="btn btn-light" href="/involved/">Get involved with ACM <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <div class="join-links reveal">
        <a href="https://discord.gg/5DzjFzhgGT" target="_blank" rel="noopener noreferrer">
          <span><strong>Join the conversation</strong><small>Connect with the community on Discord</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
        {/* TODO: replace with the real LinkedIn page URL */}
        <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
          <span><strong>Find us on LinkedIn</strong><small>Keep up with ACM @ NC State</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
        <a href="https://github.com/ACM-NCSU/ACM-NCSU.github.io" target="_blank" rel="noopener noreferrer">
          <span><strong>Build with us</strong><small>Explore the website's open-source code</small></span>
          <span class="go" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="sec" id="resources">
    <div class="wrap">
      <div class="head-row reveal">
        <div>
          <span class="eyebrow numbered"><b>03</b>&nbsp; Useful links</span>
          <h2 class="display">Your next <span class="accent">rabbit hole.</span></h2>
        </div>
        <p class="intro">A few starting points for exploring computer science at NC State and beyond.</p>
      </div>

      <div class="res-grid">
        {resourceLinks.map((item, index) => (
          <a class="res reveal" href={item.href}>
            <span class="res-n">{pad(index + 1)}</span>
            <strong>{item.title}</strong>
            <small>{item.text}</small>
            <span class="res-go" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sec-alt photo-section">
    <div class="wrap">
      <div class="head-row reveal">
        <div>
          <span class="eyebrow numbered"><b>04</b>&nbsp; Our community</span>
          <h2 class="display">Built <span class="accent">together.</span></h2>
        </div>
        <p class="intro">A look at the people, events, and experiences that make ACM at NC State.</p>
      </div>

      <div class="slideshow-container" aria-label="ACM at NC State event photos">
        {slideshowImages.map((image, index) => (
          <div class="slide" data-index={index}>
            <Image
              src={image}
              alt={`ACM at NC State event photo ${index + 1}`}
              widths={[640, 1024, 1600]}
              sizes="(max-width: 1200px) 100vw, 1200px"
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
        <span class="slide-count" id="slideCount" aria-hidden="true">01 / {pad(slideshowImages.length)}</span>
      </div>
    </div>
  </section>
</SiteLayout>

<script>
  // Homepage photo slideshow.
  const slides = document.querySelectorAll('.slide');
  const counter = document.getElementById('slideCount');

  if (slides.length) {
    let currentSlide = 0;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pad = (n: number) => String(n).padStart(2, '0');

    const showSlide = (index: number) => {
      slides.forEach((slide) => slide.classList.remove('active'));
      currentSlide = (index + slides.length) % slides.length;
      slides[currentSlide].classList.add('active');
      if (counter) counter.textContent = `${pad(currentSlide + 1)} / ${pad(slides.length)}`;
    };

    showSlide(0);
    if (!prefersReducedMotion) {
      window.setInterval(() => showSlide(currentSlide + 1), 5000);
    }
  }
</script>

<style>
  /* ---------- Hero ---------- */
  .hero { padding: clamp(56px, 8vw, 110px) 0 clamp(64px, 8vw, 112px); }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: center;
  }

  h1 {
    margin: 26px 0 0;
    font-size: clamp(3.6rem, 8.6vw, 8rem);
    line-height: .92;
    letter-spacing: -.025em;
  }

  .hero-copy { max-width: 520px; margin: 30px 0 0; color: var(--muted); font-size: 1.12rem; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 26px; margin-top: 34px; }

  .hero-note {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 40px 0 0;
    color: var(--faint);
    font-family: var(--mono);
    font-size: .76rem;
    letter-spacing: .04em;
  }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: #66db9a; box-shadow: 0 0 0 4px rgba(102,219,154,.14); }

  .hero-media { position: relative; isolation: isolate; margin: 0; }

  /* Offset hairline frame behind the photo. */
  .hero-media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: contain;
    transform: rotate(17deg); 
    transition: transform 0.3s ease;
  }

  .hero-placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    padding: 24px;
    border-radius: 8px;
    background: repeating-linear-gradient(135deg, #171513 0 14px, #1c1917 14px 28px);
    color: var(--muted);
    font-family: var(--mono);
    font-size: .8rem;
    line-height: 1.7;
    text-align: center;
  }
  .hero-placeholder code { color: var(--paper); font-family: inherit; }

  .hero-media figcaption {
    margin-top: 16px;
    color: var(--faint);
    font-family: var(--mono);
    font-size: .72rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .hero-media figcaption::before { content: "↳ "; color: var(--red-bright); }

  /* ---------- Marquee ---------- */
  .marquee { overflow: hidden; border-block: 1px solid var(--line); padding: 22px 0; }
  .marquee-track { display: flex; width: max-content; animation: marquee 48s linear infinite; }
  .marquee-group { display: flex; flex-shrink: 0; gap: 56px; margin: 0; padding: 0 56px 0 0; list-style: none; }
  .marquee-group li {
    display: flex;
    align-items: center;
    gap: 56px;
    white-space: nowrap;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    color: #d8d2c9;
  }
  .marquee-group li::after { content: "✳"; color: var(--red-bright); font-style: normal; font-size: .7em; }
  @keyframes marquee { to { transform: translateX(-50%); } }

  /* ---------- Sections ---------- */
  .sec { padding: clamp(72px, 10vw, 136px) 0; }
  .sec-alt { background: var(--bg-2); border-block: 1px solid var(--line); }

  .split { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 40px; }
  .split-label { padding-top: 14px; }

  .display { margin: 0; font-size: clamp(2.8rem, 6vw, 5.2rem); line-height: .96; }
  .intro { max-width: 520px; margin: 28px 0 0; color: var(--muted); font-size: 1.08rem; }

  .head-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; margin-bottom: 56px; }
  .head-row .display { margin-top: 18px; }
  .head-row .intro { margin: 0; flex: 0 1 400px; }

  /* ---------- Principles (ruled rows, not cards) ---------- */
  .rows { margin: 64px 0 0; padding: 0; list-style: none; border-bottom: 1px solid var(--line); }

  .row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 24px 32px;
    padding: 34px 0;
    border-top: 1px solid var(--line);
  }

  .row-n { padding-top: 6px; color: var(--red-bright); font-family: var(--mono); font-size: .8rem; }
  .row h3 { margin: 0; font-family: var(--serif); font-weight: 400; font-size: clamp(1.6rem, 2.6vw, 2.2rem); line-height: 1.1; letter-spacing: -.01em; }
  .row-text p { margin: 0; color: var(--muted); }

  .tags { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 20px 0 0; padding: 0; list-style: none; }
  .tags li { color: var(--paper); font-family: var(--mono); font-size: .74rem; letter-spacing: .04em; }
  .tags li::before { content: "/ "; color: var(--red-bright); }

  /* ---------- Event types ---------- */
  .event-list { margin-top: 64px; border-bottom: 1px solid var(--line); }

  .event-row {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 32px;
    padding: 30px 0;
    border-top: 1px solid var(--line);
    transition: padding-left .25s ease, background-color .25s ease;
  }
  .event-row:hover { padding-left: 16px; background: rgba(243,238,230,.03); }

  .event-type { color: var(--red-bright); font-family: var(--mono); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; }
  .event-main { display: grid; gap: 6px; }
  .event-title { font-family: var(--serif); font-size: clamp(1.7rem, 3vw, 2.5rem); line-height: 1.05; }
  .event-text { color: var(--muted); max-width: 520px; }
  .event-cta { color: var(--paper); font-size: .9rem; font-weight: 600; white-space: nowrap; }

  .after-list { margin: 32px 0 0; }

  /* ---------- Join (the one loud moment) ---------- */
  .join { padding: clamp(72px, 10vw, 128px) 0; background: var(--red); color: #fff; }
  .join-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: clamp(40px, 6vw, 96px); align-items: center; }

  .join .eyebrow.light { color: rgba(255,255,255,.78); }
  .join .eyebrow.light::before { background: #fff; }

  .join h2 { margin: 20px 0 0; color: #fff; font-size: clamp(2.8rem, 6vw, 5.2rem); line-height: .96; }
  .join-accent { font-style: italic; }
  .join p { max-width: 460px; margin: 26px 0 32px; color: rgba(255,255,255,.88); font-size: 1.1rem; }

  .btn-light { background: var(--paper); border-color: var(--paper); color: #1a0505; }
  .btn-light:hover { background: #fff; border-color: #fff; }

  .join-links { border-bottom: 1px solid rgba(255,255,255,.32); }
  .join-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px 0;
    border-top: 1px solid rgba(255,255,255,.32);
    transition: padding-left .25s ease;
  }
  .join-links a:hover { padding-left: 14px; }
  .join-links strong, .join-links small { display: block; }
  .join-links strong { font-size: 1.1rem; }
  .join-links small { margin-top: 2px; color: rgba(255,255,255,.78); font-size: .9rem; }
  .join-links .go { font-size: 1.3rem; }

  /* ---------- Resource teasers ---------- */
  .res-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 28px; }

  .res {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 190px;
    padding: 22px 0 26px;
    border-top: 1px solid var(--line-strong);
    transition: border-color .25s ease;
  }
  .res:hover { border-top-color: var(--red-bright); }
  .res-n { margin-bottom: 36px; color: var(--faint); font-family: var(--mono); font-size: .74rem; }
  .res strong { font-size: 1.2rem; font-weight: 600; letter-spacing: -.01em; }
  .res small { color: var(--muted); font-size: .92rem; }
  .res-go { margin-top: auto; padding-top: 18px; color: var(--red-bright); transition: transform .2s ease; }
  .res:hover .res-go { transform: translateX(4px); }

  /* ---------- Photo slideshow ---------- */
  .slideshow-container {
    position: relative;
    width: 100%;
    aspect-ratio: 3888 / 2592;
    overflow: hidden;
    border-radius: 8px;
    background: #000;
  }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity 1s ease-in-out; }
  .slide.active { opacity: 1; }
  /* <Image /> renders inside a component, so scoped styles need :global to reach the <img>. */
  .slide :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0; }

  .slide-count {
    position: absolute;
    left: 16px;
    bottom: 16px;
    padding: 6px 10px;
    border-radius: 6px;
    background: rgba(15,14,13,.72);
    color: var(--paper);
    font-family: var(--mono);
    font-size: .74rem;
    letter-spacing: .08em;
  }

  @media (max-width: 1000px) {
    .split { grid-template-columns: 1fr; gap: 20px; }
    .split-label { padding-top: 0; }
    .row { grid-template-columns: 40px minmax(0, 1fr); }
    .row-text { grid-column: 2; }
    .event-row { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .event-cta { margin-top: 6px; }
    .res-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-media { max-width: 440px; margin-right: 20px; }
    .join-grid { grid-template-columns: 1fr; }
    .head-row { flex-direction: column; align-items: flex-start; gap: 20px; margin-bottom: 40px; }
  }

  @media (max-width: 680px) {
    .res-grid { grid-template-columns: 1fr; }
    .res { min-height: 0; }
    .res-n { margin-bottom: 14px; }
    .slideshow-container { aspect-ratio: 4 / 3; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .marquee-group[aria-hidden="true"] { display: none; }
    .marquee { overflow-x: auto; }
  }
</style>
