---
import { Icon } from 'astro-icon/components';
import SiteLayout from '../pages/SiteLayout.astro';
import { SITE_TITLE } from '../consts';

const panels = [
  {
    title: 'CSC at NCSU',
    icon: 'mdi:school-outline',
    links: [
      { label: 'Computer Science Course Catalog', href: 'https://catalog.ncsu.edu/course-descriptions/csc' },
      { label: 'Undergraduate Special Topics Courses', href: 'https://my.csc.ncsu.edu/undergrad-advising/csc-undergraduate-restricted-electives/' },
      { label: 'Graduate Special Topics Courses', href: 'https://my.csc.ncsu.edu/undergrad-advising/graduate-special-topics/' },
      { label: 'Academic Success Center', href: 'https://asc.dasa.ncsu.edu/' },
    ],
  },
  {
    title: 'CSC Community',
    icon: 'mdi:account-group-outline',
    links: [
      { label: 'CSC Student Organizations', href: 'https://csc.ncsu.edu/academics/student-organizations/' },
      { label: 'CSC Discord', href: 'https://discord.gg/mmccuDpk' },
      { label: 'Hack_NCState', href: 'https://hackncstate.org/' },
      { label: 'CSC News & Events', href: 'https://csc.ncsu.edu/news/' },
    ],
  },
  {
    title: 'Career & Internships',
    icon: 'mdi:briefcase-outline',
    links: [
      { label: 'CSC ePartners', href: 'https://csc.ncsu.edu/corporate-relations/become/current/' },
      { label: 'NCSU ePack', href: 'https://careers.ncsu.edu/students/explore-jobs-and-internships/' },
      { label: 'Career Fairs', href: 'https://careers.dasa.ncsu.edu/gain-experience/career-fairs/' },
      { label: 'Career Development Center', href: 'https://careers.dasa.ncsu.edu/' },
    ],
  },
  {
    title: 'Research',
    icon: 'mdi:graph-outline',
    links: [
      { label: 'CSC Research Areas', href: 'https://csc.ncsu.edu/research/' },
      { label: 'Research Labs and Groups', href: 'https://csc.ncsu.edu/research/centers-and-labs/' },
      { label: 'Faculty Directory', href: 'https://csc.ncsu.edu/group/faculty/professors/' },
      { label: 'Undergraduate Research Courses', href: 'https://csc.ncsu.edu/academics/undergrad/undergraduate-research-or-independent-study/' },
      { label: 'NSF REU Programs', href: 'https://www.nsf.gov/funding/initiatives/reu' },
    ],
  },
];
---

<SiteLayout
  title={`Resources | ${SITE_TITLE}`}
  description="Courses, community, career, and research resources for computer science students at NC State."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Useful links</span>
      <h1>Your next <span class="accent">rabbit hole.</span></h1>
      <p class="lede">
        Everything you need to succeed in computer science at NC State, from coursework
        to career preparation and research opportunities.
      </p>
    </div>
  </section>

  <section class="page-section">
    <div class="wrap">
      <div class="resources-grid">
        {panels.map((panel) => (
          <article class="resource-panel reveal">
            <header class="panel-header">
              <span class="panel-icon"><Icon name={panel.icon} /></span>
              <h2>{panel.title}</h2>
            </header>
            <ul class="panel-links">
              {panel.links.map((link) => (
                <li>
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    <span>{link.label}</span>
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>
</SiteLayout>

<style>
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 64px clamp(36px, 6vw, 88px);
    align-items: start;
  }

  .resource-panel { border-top: 1px solid var(--line-strong); }

  .panel-header { display: flex; align-items: center; gap: 14px; padding: 24px 0 18px; }

  .panel-header h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    line-height: 1;
  }

  .panel-icon { display: grid; place-items: center; flex-shrink: 0; color: var(--red-bright); }
  .panel-icon :global(svg) { width: 24px; height: 24px; }

  .panel-links { margin: 0; padding: 0; list-style: none; }

  .panel-links li { border-top: 1px solid var(--line); }
  .panel-links li:last-child { border-bottom: 1px solid var(--line); }

  .panel-links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 15px 0;
    color: #d8d2c9;
    transition: padding-left .2s ease, color .2s ease;
  }
  .panel-links a:hover { padding-left: 10px; color: var(--paper); }

  .arrow { color: var(--red-bright); transition: transform .2s ease; }
  .panel-links a:hover .arrow { transform: translate(2px, -2px); }

  @media (max-width: 800px) {
    .resources-grid { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
